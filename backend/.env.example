# Copy to .env and edit. Everything has a safe development default except SECRET_KEY in production.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE=note2quiz.db

# Browser origins allowed to call the API (comma separated)
FRONTEND_ORIGINS=http://localhost:5173
# Used to build links in emails (password reset)
APP_URL=http://localhost:5173

# AI. Without a key the backend uses a built-in offline generator, so everything still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email. Without SMTP_HOST, emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Note2Quiz <no-reply@note2quiz.app>

# Optional
ACCESS_TOKEN_DAYS=7
MAX_UPLOAD_MB=20
